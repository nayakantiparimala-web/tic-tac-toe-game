print("===== TIC-TAC-TOE GAME =====")

board = [" " for i in range(9)]


def display_board():
    print()
    print(board[0], "|", board[1], "|", board[2])
    print("--+---+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+---+--")
    print(board[6], "|", board[7], "|", board[8])
    print()


def check_winner():
    winning_positions = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in winning_positions:
        if board[a] == board[b] == board[c] != " ":
            return board[a]

    return None


def board_full():
    return " " not in board


player = "X"

while True:

    display_board()

    print("Player", player)

    try:
        position = int(input("Choose position (1-9): ")) - 1
    except ValueError:
        print("Please enter a number.")
        continue

    if position < 0 or position > 8:
        print("Choose a number between 1 and 9.")
        continue

    if board[position] != " ":
        print("Position already occupied.")
        continue

    board[position] = player

    winner = check_winner()

    if winner:
        display_board()
        print("🎉 Player", winner, "wins!")
        break

    if board_full():
        display_board()
        print("Game Draw!")
        break

    if player == "X":
        player = "O"
    else:
        player = "X"

print("Game Over!")